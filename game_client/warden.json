{
  "schema_version": 1,
  "protection": "Protected",
  "package": {
    "name": "game_client",
    "profile": "game_client",
    "build_id_source": "cargo_env"
  },
  "vm": {
    "execution_tiers": {
      "interpreter": true,
      "quickened_interpreter": true,
      "superinstruction_interpreter": true,
      "signed_aot_stub": true,
      "policy_runtime_jit": false,
      "server_signed_dynamic_variant": true
    }
  },
  "vm_program_gate": {
    "enabled": true,
    "default_unlock": "per_session",
    "high_value_unlock": "per_match",
    "critical_unlock": "per_call",
    "require_hardware_proof": true,
    "require_warden_ticket": true,
    "seal_function_bytecode": true,
    "seal_decoy_programs": true
  },
  "integrity": {
    "startup_root_check": true,
    "low_frequency_recheck": true,
    "backend_challenge_bound": true,
    "handler_islands": 4,
    "peer_checks": true
  },
  "diversification": {
    "register_remap": true,
    "block_layout": true,
    "function_order": true,
    "constant_pool_order": true,
    "opcode_numbering": "per_package",
    "handler_islands": true,
    "cohort_variants": true
  },
  "function_inflation": {
    "enabled": true,
    "profile": "large",
    "min_expansion_ratio": 6,
    "max_expansion_ratio": 24,
    "max_extra_basic_blocks": 96,
    "max_extra_instructions": 2048,
    "split_basic_blocks": true,
    "split_return_paths": true,
    "semantic_padding": true,
    "decoy_blocks": true,
    "guard_braids": true,
    "ticket_gated_decoys": true,
    "shadow_equivalent_paths": true,
    "preserve_benchmark_budget": true
  },
  "evidence": {
    "class": "redacted",
    "include_raw_memory_bytes": false,
    "include_hardware_identity": false,
    "include_user_identity": false,
    "include_module_paths": false
  },
  "bevy": {
    "client_plugin": "existing_game_client_plugin",
    "startup_verify": true,
    "integrity_recheck_seconds": 30,
    "service_heartbeat_seconds": 5,
    "frame_budget_us": 300
  }
}
