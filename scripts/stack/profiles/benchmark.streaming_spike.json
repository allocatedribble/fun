{
  "schema_version": "stack_profile_v1",
  "name": "benchmark.streaming_spike",
  "description": "Benchmark profile for startup and world-stream spike capture.",
  "build": {
    "release": false,
    "static_bevy": false
  },
  "features": {
    "disable_clouds": false,
    "enable_dx12_dlss_rr": false,
    "disable_dlss_rr": false,
    "render_unknown_vendor": false
  },
  "runtime": {
    "scene_id": "",
    "frame_graph_trace": false,
    "frame_graph_trace_format": "",
    "start_mode": null,
    "client_mode": "",
    "benchmark_lane": "streaming_spike"
  },
  "processes": {
    "server": true,
    "client": true,
    "launcher": false
  },
  "diagnostics": {
    "render": true,
    "trace": false,
    "render_profile_verbose": false,
    "frame_time": false,
    "benchmark_log_minimal": true,
    "log_stream_verbose": false,
    "log_net_verbose": false,
    "log_render_verbose": false
  },
  "render": {
    "backend": "dx12",
    "present_mode": "immediate",
    "max_frame_latency": 0,
    "geometry_policy": "hybrid",
    "window_width": 0,
    "window_height": 0,
    "maximized": false,
    "disable_fps_overlay": true,
    "enable_fps_overlay": false,
    "cloud_quality": "balanced",
    "cloud_internal_scale": "0.5",
    "cloud_temporal": "1",
    "cloud_shadows": "0",
    "cloud_profile": "scattered",
    "cloud_debug_overlay": "",
    "stream_render_prep_budget_ms": 0,
    "stream_render_prep_max_chunks_per_frame": 0
  },
  "security": {
    "tls_mode": "development"
  }
}
