{
  "schema_version": "stack_profile_v1",
  "name": "alpha.local",
  "description": "Alpha local stack: backend/server/client launch spine using the fun renderer, arena-blockout scene, native rvelte route path, and canonical frame graph trace outputs.",
  "build": {
    "release": false,
    "static_bevy": false
  },
  "features": {
    "disable_solari": false,
    "disable_meshlets": false,
    "disable_clouds": false,
    "enable_dx12_dlss_rr": false,
    "disable_dlss_rr": false,
    "solari_debug_direct_visibility": false,
    "render_unknown_vendor": false
  },
  "env": {
    "FUN_RENDERER_BACKEND": "fun",
    "FUN_SCENE_ID": "arena-blockout",
    "FUN_FRAME_GRAPH_TRACE": "1",
    "FUN_FRAME_GRAPH_TRACE_FORMAT": "compressed,json,markdown",
    "FUN_START_MODE": "game",
    "FUN_CLIENT_MODE": "joined_game"
  },
  "processes": {
    "backend": false,
    "server": true,
    "client": true,
    "launcher": false
  },
  "diagnostics": {
    "render": true,
    "trace": false,
    "render_profile_verbose": false,
    "frame_time": true,
    "benchmark_log_minimal": false,
    "log_stream_verbose": false,
    "log_net_verbose": false,
    "log_render_verbose": false
  },
  "render": {
    "backend": "dx12",
    "present_mode": "immediate",
    "max_frame_latency": 0,
    "geometry_policy": "hybrid",
    "meshlet_min_triangles": 512,
    "window_width": 0,
    "window_height": 0,
    "maximized": false,
    "disable_fps_overlay": false,
    "enable_fps_overlay": false,
    "solari_arch": "budgeted",
    "solari_target_fps": 144,
    "solari_frame_budget_ns": 6944444,
    "solari_gpu_budget_ns": 3000000,
    "solari_visual_target": "competitive",
    "solari_denoise_mode": "balanced-fast",
    "solari_internal_scale": "1.0",
    "solari_blas_compaction_vertices": 0,
    "solari_debug_overlay": "",
    "cloud_quality": "",
    "cloud_internal_scale": "",
    "cloud_temporal": "",
    "cloud_shadows": "",
    "cloud_profile": "",
    "cloud_debug_overlay": "",
    "stream_render_prep_budget_ms": 0,
    "stream_render_prep_max_chunks_per_frame": 0
  },
  "security": {
    "tls_mode": "development"
  }
}
