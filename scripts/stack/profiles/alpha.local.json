{
  "schema_version": "stack_profile_v1",
  "name": "alpha.local",
  "description": "Alpha local stack: backend/server/client launch spine using fun-renderer virtual geometry, Lux virtual shadows, fun-ecs/Avis handoff authority, arena-blockout scene, native rvelte route path, and canonical frame graph trace outputs.",
  "build": {
    "release": false,
    "static_engine": true
  },
  "features": {
    "disable_clouds": false,
    "enable_dx12_dlss_rr": false,
    "disable_dlss_rr": false,
    "render_unknown_vendor": false
  },
  "runtime": {
    "scene_id": "arena-blockout",
    "frame_graph_trace": true,
    "frame_graph_trace_format": "compressed,json,markdown",
    "start_mode": "game",
    "client_mode": "joined_game",
    "benchmark_lane": ""
  },
  "processes": {
    "backend": false,
    "server": true,
    "client": true,
    "launcher": false
  },
  "diagnostics": {
    "render": true,
    "trace": false,
    "render_profile_verbose": false,
    "frame_time": true,
    "benchmark_log_minimal": false,
    "log_stream_verbose": false,
    "log_net_verbose": false,
    "log_render_verbose": false
  },
  "render": {
    "backend": "dx12",
    "present_mode": "immediate",
    "max_frame_latency": 0,
    "geometry_policy": "virtual_static_experimental",
    "window_width": 0,
    "window_height": 0,
    "maximized": false,
    "disable_fps_overlay": false,
    "enable_fps_overlay": false,
    "cloud_quality": "",
    "cloud_internal_scale": "",
    "cloud_temporal": "",
    "cloud_shadows": "",
    "cloud_profile": "",
    "cloud_debug_overlay": "",
    "stream_render_prep_budget_ms": 0,
    "stream_render_prep_max_chunks_per_frame": 0
  },
  "security": {
    "tls_mode": "development"
  }
}
